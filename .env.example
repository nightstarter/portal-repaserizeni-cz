APP_NAME="Repase řízení"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_TIMEZONE=Europe/Prague
PRODUCT_REPRICING=DEFERRED_EXTERNAL_SYSTEM

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_repaserizeni
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MESSAGE_ATTACHMENTS_DISK=local
MESSAGE_ATTACHMENTS_MAX_COUNT=5
MESSAGE_ATTACHMENTS_MAX_KILOBYTES=10240

DISCUSSION_EMAIL_ENABLED=false
BUYBACK_CUSTOMER_EMAIL_ENABLED=false
DISCUSSION_EMAIL_MAX_ATTEMPTS=5
DISCUSSION_EMAIL_BATCH_SIZE=50
DISCUSSION_EMAIL_RETRY_MINUTES=5
DISCUSSION_EMAIL_LOCK_MINUTES=10

LEGACY_SHOP_DB_HOST=
LEGACY_SHOP_DB_DRIVER=mysql
LEGACY_SHOP_DB_URL=
LEGACY_SHOP_DB_PORT=3306
LEGACY_SHOP_DB_DATABASE=
LEGACY_SHOP_DB_USERNAME=
LEGACY_SHOP_DB_PASSWORD=
LEGACY_SHOP_DB_SOCKET=
LEGACY_SHOP_DB_CHARSET=utf8mb4
LEGACY_SHOP_DB_COLLATION=utf8mb4_unicode_ci
LEGACY_SHOP_DB_PREFIX=
LEGACY_SHOP_DB_TIMEZONE=+00:00
LEGACY_SHOP_IMPORT_ENABLED=false
LEGACY_SHOP_IMPORT_FROM=
LEGACY_SHOP_MIN_ORDER_ID=
LEGACY_SHOP_IMPORT_BATCH_SIZE=100
LEGACY_SHOP_MAPPING_VERIFIED=false
LEGACY_SHOP_PRESTASHOP_PREFIX=ps_
LEGACY_SHOP_PAID_STATE_IDS_JSON=[2]
LEGACY_SHOP_CARRIER_HANDOVER_MAP_JSON={"18":"GLS","19":"PERSONAL_PICKUP","20":"PERSONAL_PICKUP"}

POHODA_BRIDGE_ENABLED=false
POHODA_BRIDGE_KEY_ID=
POHODA_BRIDGE_SECRET=
POHODA_BRIDGE_PREVIOUS_KEY_ID=
POHODA_BRIDGE_PREVIOUS_SECRET=
POHODA_BRIDGE_TIMESTAMP_TOLERANCE=300
POHODA_BRIDGE_STALE_MINUTES=30
POHODA_BRIDGE_MAX_BATCH_ITEMS=500
POHODA_BRIDGE_MAX_BODY_BYTES=2097152
POHODA_BRIDGE_SNAPSHOT_RUN_TIMEOUT_MINUTES=30
POHODA_BRIDGE_PRODUCT_PREFIXES=RR
POHODA_BRIDGE_WAREHOUSES=DECIN
POHODA_BRIDGE_IP_ALLOWLIST=
POHODA_BRIDGE_RATE_LIMIT_PER_MINUTE=60
POHODA_BRIDGE_COMMAND_LEASE_MINUTES=5
POHODA_CONNECTOR_PHP_VERSION=7.4.33
POHODA_CONNECTOR_OS_VERSION="Windows Server 2012 R2"

OPS_HEARTBEAT_STALE_MINUTES=15
OPS_SNAPSHOT_STALE_MINUTES=30
OPS_MIN_FREE_DISK_MB=1024

# Configure only after a real production COMPLETE manifest exists outside the webroot.
BACKUP_LATEST_MANIFEST=
BACKUP_MAX_AGE_HOURS=26
BACKUP_RESTORE_TEST_MAX_AGE_DAYS=100
BACKUP_PRODUCTION_DB_HOST=
BACKUP_PRODUCTION_DB_PORT=3306
BACKUP_PRODUCTION_DB_DATABASE=
BACKUP_DUMP_BINARY=mariadb-dump
BACKUP_DUMP_TIMEOUT_SECONDS=3600
BACKUP_DIAGNOSE_TIMEOUT_SECONDS=60
BACKUP_DIAGNOSE_PARENT=/absolute/private/diagnostic-parent
BACKUP_REQUEST_DRAIN_SECONDS=10

