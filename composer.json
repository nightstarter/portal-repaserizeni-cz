{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "nightstarter/portal-repaserizeni-cz",
  "type": "project",
  "description": "Transactional portal for steering rack refurbishments.",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test:guard": "@php scripts/assert-test-database.php",
    "test": [
      "@test:guard",
      "@php artisan test"
    ],
    "analyse": "@php scripts/lint.php",
    "check": [
      "@composer validate --strict",
      "@php vendor/bin/pint --test",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
